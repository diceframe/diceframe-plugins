{
  "schema_version": 1,
  "content_schema_version": 2,
  "locale_schema_version": 1,
  "default_locale": "zh-CN",
  "supported_locales": ["zh-CN"],
  "id": "my-content-pack",
  "name": "我的内容包",
  "version": "0.1.0",
  "description": "改这里：一句话说明这个包提供什么（世界、规则、资料册或冒险）。",
  "plugin_type": "content-pack",
  "config_schema": "config.schema.json",
  "capabilities": [
    "content.world"
  ],
  "permissions": [
    "plugin.config",
    "content.read",
    "content.import"
  ],
  "contributes": {
    "world_templates": [
      "content/worlds/*.json"
    ]
  },
  "requires": {
    "rulesets": [
      { "id": "core:dnd2024" }
    ]
  },
  "docs": "README.md"
}
