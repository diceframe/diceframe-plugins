{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiceFrame plugin marketplace details",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "repository_url", "distribution", "risk_level", "update_policy", "installable", "manifest"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "name": {"type": "string"},
      "version": {"type": "string"},
      "description": {"type": "string"},
      "plugin_type": {"type": "string"},
      "repository_url": {"type": "string", "format": "uri"},
      "branch": {"type": "string"},
      "author": {"type": "string", "description": "GitHub 仓库所有者，作为插件作者展示"},
      "stars": {"type": "integer", "minimum": 0, "description": "GitHub 仓库 star 数，作为商店受欢迎度展示"},
      "plugin_path": {"type": "string"},
      "release_tag": {"type": "string"},
      "release_url": {"type": "string", "format": "uri"},
      "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "archive_url": {"type": "string", "format": "uri"},
      "latest": {
        "type": "object",
        "description": "插件仓库最新正式 Release 的解析结果，由每日同步刷新",
        "required": ["version", "release_tag", "release_url", "commit_sha", "requires_approval"],
        "properties": {
          "version": {"type": "string", "description": "最新 Release 中 plugin.json 的版本"},
          "release_tag": {"type": "string"},
          "release_url": {"type": "string", "format": "uri"},
          "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "published_at": {"type": "string"},
          "requires_approval": {"type": "boolean", "description": "新版本是否扩大权限或改变运行方式，需要重新审核"}
        },
        "additionalProperties": false
      },
      "distribution": {"enum": ["repository", "bundled"]},
      "risk_level": {"enum": ["declarative", "unrestricted-process", "bundled", "unknown"]},
      "update_policy": {"enum": ["automatic", "notify", "application", "approval-required", "blocked"]},
      "trust_level": {"enum": ["official", "community"]},
      "installable": {"type": "boolean"},
      "verification_error": {"type": "string"},
      "approved_permissions": {"type": "array", "items": {"type": "string"}},
      "permissions": {"type": "array", "items": {"type": "string"}},
      "capabilities": {"type": "array", "items": {"type": "string"}},
      "approved_release_tag": {"type": "string"},
      "approved_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "approved_archive_url": {"type": "string", "format": "uri"},
      "approved_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "listing_status": {"enum": ["approved", "paused", "withdrawn"]},
      "listing_status_reason": {"type": "string"},
      "listing_status_at": {"type": "string", "format": "date-time"},
      "permission_changes": {"type": "array", "items": {"type": "string"}},
      "manifest": {
        "type": "object",
        "properties": {
          "schema_version": {"const": 1},
          "id": {"type": "string"},
          "name": {"type": "string"},
          "version": {"type": "string"},
          "description": {"type": "string"},
          "plugin_type": {"type": "string"},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "permissions": {"type": "array", "items": {"type": "string"}},
          "content_profile": {"enum": ["content-pack", "adventure-module"]},
          "content_delivery_mode": {"enum": ["legacy_autoimport", "catalog"]},
          "compatible_rulesets": {"type": "array", "maxItems": 6, "items": {"type": "string"}},
          "system_agnostic": {"type": "boolean"},
          "adventure_packages": {"type": "array", "items": {"type": "string"}},
          "ruleset_catalogs": {"type": "array", "items": {"type": "string"}},
          "ruleset_runtime": {
            "type": "object",
            "required": ["runtime_id"],
            "properties": {
              "runtime_id": {"type": "string", "minLength": 1, "maxLength": 160},
              "runtime_version": {"type": "integer", "minimum": 1},
              "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
              "capabilities": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  }
}
